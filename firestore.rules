rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can read/write their own data only
    match /users/{email} {
      allow read, write: if true;
    }

    // Deposits - anyone can create, admin can approve
    match /deposits/{doc} {
      allow read, write: if true;
    }

    // Withdrawals - anyone can create, admin can approve
    match /withdrawals/{doc} {
      allow read, write: if true;
    }

    // Task claims - user can claim
    match /taskClaims/{doc} {
      allow read, write: if true;
    }

    // Referrals
    match /referrals/{doc} {
      allow read, write: if true;
    }

    // Settings - M-PESA LIVE number - public read, admin write
    match /settings/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Admin stats - reset stays 0 logic
    match /adminStats/{doc} {
      allow read, write: if true;
    }
  }
}
